---
import BaseLayout from '../layouts/BaseLayout.astro';
import meta from '../content/pages/contact.json';
import bodyRaw from '../content/bodies/contact.html?raw';
import { stripFrontmatter } from '../lib/content';

const body = stripFrontmatter(bodyRaw);
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path}>
  <main id="main" set:html={body} />
</BaseLayout>
