---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import meta from '../content/pages/resources.json';
import copy from '../content/copy/resources.json';

const articleIllustrations = [
  `<svg viewBox="0 0 640 400" role="img" aria-label="Illustration of dawn breaking over an open horizon">
  <defs><linearGradient id="g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a2c1c"/><stop offset="0.55" stop-color="#2a2118"/><stop offset="1" stop-color="#1c160f"/></linearGradient>
  <radialGradient id="sun1" cx="0.7" cy="0.35" r="0.5"><stop offset="0" stop-color="#e7c17f"/><stop offset="0.5" stop-color="#c9a05a"/><stop offset="1" stop-color="#c9a05a" stop-opacity="0"/></radialGradient></defs>
  <rect width="640" height="400" fill="url(#g1)"/>
  <circle cx="450" cy="150" r="120" fill="url(#sun1)"/>
  <circle cx="450" cy="150" r="46" fill="#e7c17f" opacity="0.85"/>
  <path d="M0 300 C 160 270, 300 290, 640 262 L640 400 L0 400 Z" fill="#14110e" opacity="0.7"/>
  <path d="M0 340 C 220 316, 420 342, 640 320 L640 400 L0 400 Z" fill="#0f0c08"/>
</svg>`,
  `<svg viewBox="0 0 640 400" role="img" aria-label="Illustration of still water beneath an open sky">
  <defs><linearGradient id="g3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a2c1c"/><stop offset="0.5" stop-color="#4a5240"/><stop offset="1" stop-color="#2a2118"/></linearGradient></defs>
  <rect width="640" height="400" fill="url(#g3)"/>
  <circle cx="200" cy="130" r="52" fill="#e7c17f" opacity="0.7"/>
  <rect y="230" width="640" height="170" fill="#20281f" opacity="0.6"/>
  <path d="M40 280 H 320 M80 310 H 380 M120 340 H 300" stroke="#c9a05a" stroke-width="3" opacity="0.4" stroke-linecap="round"/>
</svg>`,
  `<svg viewBox="0 0 640 400" role="img" aria-label="Illustration of an open field under a warm sky">
  <defs><linearGradient id="g5" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c9a05a" stop-opacity="0.45"/><stop offset="0.6" stop-color="#2a2118"/><stop offset="1" stop-color="#1c160f"/></linearGradient></defs>
  <rect width="640" height="400" fill="url(#g5)"/>
  <circle cx="500" cy="120" r="60" fill="#e7c17f" opacity="0.6"/>
  <path d="M0 280 Q 320 250 640 280 L640 400 L0 400 Z" fill="#3d3225"/>
  <path d="M60 300 V340 M100 296 V336 M140 302 V342 M540 300 V340 M580 296 V336" stroke="#6e6e42" stroke-width="4" opacity="0.6"/>
</svg>`,
];
---

<BaseLayout title={meta.title} description={meta.description} path={meta.path}>
  <main id="main">
    <PageHero
      crumb="Resources"
      eyebrow={copy.hero.eyebrow}
      title={copy.hero.title}
      lede={copy.hero.lede}
    />

    <section class="section section--tight" aria-labelledby="articles-h">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{copy.articles.eyebrow}</p>
          <h2 id="articles-h">{copy.articles.title}</h2>
          <p class="section-head__lede">{copy.articles.lede}</p>
        </div>
        <div class="article-grid">
          {copy.articles.cards.map((card, i) => (
            <article class="article-card" data-reveal>
              <div class="article-card__media" set:html={articleIllustrations[i % articleIllustrations.length]} />
              <div class="article-card__body">
                <span class="article-card__tag">{card.tag}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <p class="article-card__meta"><span class="placeholder-flag">Add full article</span></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="horizon" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0 70 L180 30 L360 58 L560 18 L760 54 L980 22 L1200 60 L1440 34 L1440 80 L0 80 Z" fill="currentColor"/></svg>
    </div>

    <section class="section section--sand" aria-labelledby="downloads-h">
      <div class="wrap--narrow" data-reveal>
        <p class="eyebrow">{copy.downloads.eyebrow}</p>
        <h2 id="downloads-h">{copy.downloads.title}</h2>
        <p class="mt-1 muted">{copy.downloads.lede}</p>
        <ul class="icon-list mt-2">
          {copy.downloads.items.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 5c3-1 6-1 8 0v14c-2-1-5-1-8 0z"/><path d="M20 5c-3-1-6-1-8 0v14c2-1 5-1 8 0z"/></svg>
              <div>
                <strong>{item}</strong>
                <p class="muted" style="margin:0.2rem 0 0"><span class="placeholder-flag">Add downloadable file</span></p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="exercises-h">
      <div class="wrap--narrow">
        <div class="section-head section-head--left" data-reveal>
          <p class="eyebrow">{copy.exercise.eyebrow}</p>
          <h2 id="exercises-h">{copy.exercise.title}</h2>
        </div>
        <ol class="steps-list">
          {copy.exercise.steps.map((step) => (
            <li data-reveal>
              <span class="step-num" aria-hidden="true">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="horizon" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0 50 C 180 30, 360 30, 540 50 C 720 70, 900 70, 1080 50 C 1260 30, 1350 30, 1440 42 L1440 80 L0 80 Z" fill="currentColor"/></svg>
    </div>

    <section class="section section--ink" aria-labelledby="prompts-h">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{copy.prayerPrompts.eyebrow}</p>
          <h2 id="prompts-h">{copy.prayerPrompts.title}</h2>
          <p class="section-head__lede">{copy.prayerPrompts.lede}</p>
        </div>
        <div class="prompt-grid">
          {copy.prayerPrompts.items.map((item) => (
            <div class="prompt-card" data-reveal>
              <span class="prompt-card__pillar">{item.pillar}</span>
              <p>{item.prompt}</p>
            </div>
          ))}
        </div>
        <p class="mt-2" style="text-align:center">
          <a class="arrow-link" href="/pillars">{copy.prayerPrompts.cta} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </p>
      </div>
    </section>

    <section class="section" id="updates" aria-labelledby="updates-h">
      <div class="wrap--narrow">
        <div class="section-head section-head--left" data-reveal>
          <p class="eyebrow">{copy.updates.eyebrow}</p>
          <h2 id="updates-h">{copy.updates.title}</h2>
          <p>{copy.updates.intro}</p>
        </div>
        <div data-reveal>
          <form
            class="form-card"
            id="updates-form"
            data-enhanced
            data-next="/thank-you"
            action="https://formsubmit.co/sunbirdsrvresortvillage@gmail.com"
            method="POST"
            novalidate
          >
            <h2 class="visually-hidden">Resource updates signup</h2>
            <div class="form-grid form-grid--2">
              <div class="field">
                <label for="n-first">First name <span class="hint">(optional)</span></label>
                <input type="text" id="n-first" name="first_name" autocomplete="given-name" />
                <p class="field__error" aria-live="polite"></p>
              </div>
              <div class="field">
                <label for="n-email">Email <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="n-email" name="email" autocomplete="email" required />
                <p class="field__error" aria-live="polite"></p>
              </div>
              <div class="checkbox checkbox-field field full">
                <input type="checkbox" id="n-marketing" name="marketing_consent" required />
                <label for="n-marketing">Yes, send me occasional resource updates and encouragement by email.
                  I can unsubscribe at any time. <span class="req" aria-hidden="true">*</span></label>
                <p class="field__error" aria-live="polite"></p>
              </div>
              <input type="hidden" name="list" value="resource-updates" />
              <input type="hidden" name="_subject" value="New resource-updates signup — Leaving Egypt" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_next" value="https://leavingegypt.example.com/thank-you" />
              <input type="hidden" name="submission_source" value="Leaving Egypt website" />
              <input type="hidden" name="_page_url" value="" />
              <div class="hp-field" aria-hidden="true">
                <label for="n-company">Do not fill this field</label>
                <input type="text" id="n-company" name="_honey" tabindex="-1" autocomplete="off" />
              </div>
            </div>
            <div class="btn-row" style="margin-top:1.25rem">
              <button class="btn btn--dark" type="submit">
                Sign up for updates <span class="btn__spinner" aria-hidden="true"></span>
              </button>
            </div>
            <p class="form-status" role="status" aria-live="polite"></p>
            <p class="field__error" style="margin-top:0.75rem;font-weight:400;color:var(--text-soft)">
              {copy.updates.privacyNote}
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
